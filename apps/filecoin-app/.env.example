# filecoin-api base URL, here a local `wrangler dev`. Unset, the site advertises
# https://api.filecoin.io and fetches https://api.filecoin.cloud, which server
# renders on the filecoin.cloud zone can reach. Don't set it to api.filecoin.io.
VITE_FILECOIN_API_URL=http://localhost:8787
# filecoin-api MCP server URL (defaults to production, or to VITE_FILECOIN_API_URL/mcp when that is set)
VITE_FILECOIN_MCP_URL=https://mcp.filecoin.io
# filecoin-app public origin for canonical and Open Graph URLs (defaults to production)
VITE_SITE_URL=https://poc.filecoin.cloud
