{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fil-app",
  // FilOz Cloudflare account, which holds the filecoin.cloud zone.
  "account_id": "ea5f8b8a063d8e31ae32dec2e89342d5",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // TanStack Start renders pages in the Worker; the Cloudflare Vite plugin
  // serves the client build as static assets. `src/server.ts` wraps Start's
  // handler to answer Markdown-only requests in Markdown.
  "main": "src/server.ts",
  "routes": [{ "pattern": "poc.filecoin.cloud", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": true,
  // Required by `wrangler preview`; the app needs no preview bindings.
  // https://developers.cloudflare.com/workers/previews/configuration/
  "previews": {},
  "observability": { "enabled": true }
}
