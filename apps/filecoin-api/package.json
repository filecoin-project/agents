{
  "name": "filecoin-api",
  "private": true,
  "version": "0.7.2",
  "type": "module",
  "description": "Cloudflare Worker REST API and MCP server for Filecoin onchain data",
  "scripts": {
    "dev": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler dev --var MCP_PUBLIC_URL:",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "cf-typegen": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types",
    "typecheck": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --check && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen:openapi": "vitest run test/openapi.test.ts -u",
    "lint": "biome check .",
    "check": "pnpm typecheck && pnpm test && pnpm lint"
  },
  "dependencies": {
    "@filoz/synapse-core": "catalog:",
    "@hono/zod-openapi": "1.6.3",
    "@modelcontextprotocol/server": "2.4.0",
    "@scalar/hono-api-reference": "0.12.21",
    "hono": "4.13.19",
    "multiformats": "14.0.5",
    "postgres": "4.1.1",
    "viem": "2.57.20",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.3",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "5.1.0",
    "wrangler": "4.163.0"
  }
}
