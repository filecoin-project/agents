{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fil-api",
  // FilOz Cloudflare account, which holds the filecoin.cloud zone.
  "account_id": "ea5f8b8a063d8e31ae32dec2e89342d5",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // Production is served from the custom domains only; Previews use workers.dev.
  // The MCP hosts serve only the MCP endpoint, at `/` (see src/mcp-host.ts).
  "routes": [
    { "pattern": "api.filecoin.cloud", "custom_domain": true },
    { "pattern": "mcp.filecoin.cloud", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": true,
  // Run next to Hyperdrive's connection pool, which sits in Frankfurt for the
  // Helsinki indexer databases. Previews ignore it today. See README "Placement".
  // https://developers.cloudflare.com/workers/configuration/placement/
  "placement": { "region": "gcp:europe-west3" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  // One Hyperdrive config per network. Create with:
  //   wrangler hyperdrive create fil-api-calibration --connection-string="postgresql://..."
  // Local dev reads CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_<BINDING> from .env.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_CALIBRATION",
      "id": "09dbc3226bff4457a7a41f5e48041a69"
    },
    {
      "binding": "HYPERDRIVE_MAINNET",
      "id": "fcdad634474a4b8bb15649ba2b002c3a"
    }
  ],
  // Comma-separated hostnames that serve only the MCP endpoint.
  "vars": { "MCP_HOSTS": "mcp.filecoin.cloud" },
  "ratelimits": [
    {
      "name": "RATE_LIMIT_API",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_MCP",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  // Worker Previews (`wrangler preview`) do not inherit bindings. Previews read
  // the same read-only databases but count against separate rate limits.
  // https://developers.cloudflare.com/workers/previews/configuration/
  "previews": {
    // Previews run on workers.dev, which is no MCP host.
    "vars": { "MCP_HOSTS": "" },
    "hyperdrive": [
      {
        "binding": "HYPERDRIVE_CALIBRATION",
        "id": "09dbc3226bff4457a7a41f5e48041a69"
      },
      {
        "binding": "HYPERDRIVE_MAINNET",
        "id": "fcdad634474a4b8bb15649ba2b002c3a"
      }
    ],
    "ratelimits": [
      {
        "name": "RATE_LIMIT_API",
        "namespace_id": "2001",
        "simple": { "limit": 120, "period": 60 }
      },
      {
        "name": "RATE_LIMIT_MCP",
        "namespace_id": "2002",
        "simple": { "limit": 60, "period": 60 }
      }
    ]
  }
}
