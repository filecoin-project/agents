{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@hugomrdias/configs/biome"],
  "files": {
    "includes": ["!!**/.agents", "!!**/test/snapshots"]
  },
  "linter": {
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "zod": {
                "importNames": ["z"],
                "message": "Use `import * as z from 'zod'`. A named `z` import makes bundlers keep all of zod, including its locales."
              }
            }
          }
        }
      }
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    },
    "parser": {
      "frontmatter": true
    }
  },
  "overrides": [
    {
      "includes": ["**/CHANGELOG.md"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["plugins/**/*.json"],
      "json": {
        "formatter": {
          "expand": "always"
        }
      }
    },
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
